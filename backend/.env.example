# BrandSentry AI — Environment Configuration Template
# Duplicate this file to .env in backend/ or root and populate appropriate values.
# NEVER commit .env or secrets to version control.

# Application Settings
PROJECT_NAME="BrandSentry AI"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# Storage Directories (Relative to backend root or absolute)
DATA_DIR="../data"
UPLOADS_DIR="../data/uploads"
CHROMA_PERSIST_DIR="../data/chroma"

# Embedding Model Configuration (Provider-Independent)
EMBEDDING_PROVIDER="sentence-transformers"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# LLM Service Configuration (Provider-Independent Interface)
# Supported provider placeholders: openai, gemini, anthropic, ollama, custom
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-1.5-flash"
LLM_API_KEY="YOUR_API_KEY_HERE"
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=2048
